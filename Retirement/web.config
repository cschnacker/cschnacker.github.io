<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer><staticContent><remove fileExtension=".json"/><mimeMap fileExtension=".json" mimeType="application/json"/><remove fileExtension=".svg"/><mimeMap fileExtension=".svg" mimeType="image/svg+xml"/></staticContent><httpProtocol><customHeaders><remove name="Cache-Control"/><add name="Cache-Control" value="no-cache"/></customHeaders></httpProtocol></system.webServer></configuration>
